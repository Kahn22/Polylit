        {
          "id": "occ_parure_1882a890d21a7f119e9b5ebd",
          "workId": "wrk_maupassant_la_parure",
          "unitId": "unt_maupassant_parure_084",
          "passage": "Il se rendit à la Préfecture de police, aux journaux, pour faire promettre une récompense, aux compagnies de petites voitures, partout enfin où un soupçon d’espoir le poussait.",
          "span": [
            59,
