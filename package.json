  "scripts": {
    "dev": "vite",
    "build": "npm run build:domain && npm run build:delivery && npm run build:app && npm run check:performance",
    "build:domain": "tsc -p tsconfig.build.json",
    "build:delivery": "node dist/cli/build-delivery.js",
    "build:local-review": "npm run build:domain && node dist/cli/build-delivery.js --local-review && vite build --outDir review-build && node scripts/create-route-pages.mjs --directory review-build && node scripts/check-performance.mjs --directory review-build",
    "build:app": "vite build && node scripts/create-route-pages.mjs",
    "check": "npm run typecheck && npm run sources:check && python3 -m unittest discover -s tests -p 'test_checkpoint_integrity.py' && npm test",
    "check:performance": "node scripts/check-performance.mjs",
    "content:prepare": "npm run build:domain && node dist/cli/prepare-fixtures.js",
    "content:build": "npm run build:domain && npm run build:delivery",
    "content:check": "npm run build:domain && node dist/cli/validate-publication.js",
