    "editorial:checkpoint": "python3 scripts/editorial-checkpoint.py",
    "editorial:verify": "python3 scripts/checkpoint_integrity.py",
    "pipeline:zola": "npm run build:domain && node dist/cli/plan-zola.js && node dist/cli/review-zola.js && node dist/cli/report-zola-coverage.js && node dist/cli/report-zola-editorial-batches.js && node dist/cli/process-zola.js",
    "audit:zola": "npm run build:domain && node dist/cli/audit-zola.js",
    "content:review:parure:01": "npm run build:domain && node scripts/prepare-maupassant-batch-01.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir tests --maxWorkers 2",
    "sources:check": "node scripts/check-text-sources.mjs",
